{% extends "base.html" %}
{% block title %}Dashboard | School SMS{% endblock %}
{% block page_title %}Dashboard{% endblock %}
{% block content %}


<div class="container-fluid">

    <div class="row">

        <!-- SIDEBAR -->
        <aside class="col-md-3 col-lg-2 p-3 sidebar">

            <h5 class="text-white mb-4">
                <i class="bi bi-mortarboard-fill"></i>
                School SMS
            </h5>

            <nav class="nav flex-column">

                <a
                    href="#"
                    class="nav-link"
                >
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard
                </a>

                <a
                    href="{% url 'dashboard:student_menu' %}"
                    class="nav-link"
                >
                    <i class="bi bi-people me-2"></i>
                    Students
                </a>

                <a
                    href="{% url 'dashboard:academic_menu' %}"
                    target="_blank" class="nav-link"
                >
                    <i class="bi bi-journal-bookmark me-2"></i>
                    Accademics
                </a>

                <a
                    href="{% url 'dashboard:assessment_menu' %}"
                    target="_blank" class="nav-link active"
                >
                    <i class="bi bi-clipboard-data me-2"></i>
                    Assessments
                </a>

                <a
                    href="#"
                    class="nav-link"
                >
                    <i class="bi bi-bar-chart me-2"></i>
                    Results
                </a>

                <a
                    href="#"
                    class="nav-link"
                >
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Report Cards
                </a>

                <a
        href="{% url 'dashboard:school_menu' %}"
        target="_blank" class="nav-link"
    >

        <i class="bi bi-building"></i>

        <span>
            School
        </span>

    </a>

    <a
        href="{% url 'schools:settings' %}"
        class="nav-link"
    >

        <i class="bi bi-gear"></i>

        <span>
            School Settings
        </span>

    </a>

    
    <div class="sidebar-bottom pd">

        <a
        href="#"  target="_blank"
        class="btn btn-outline-light"
        >
        <i class="bi bi-pencil"></i>
        View Profile
    </a>
    
    
           
            
            <a class="mb-3 pt-5">
                <form method="post" action="#">
                    {% csrf_token %}
                    <button type="submit" class="dropdown-item">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </button>
                </form>
            </a>

        </div>
        
        
    </nav>
    </aside>
    
    
    <!-- MAIN -->
        <main class="col-md-9 col-lg-10 px-0 main-content">

    <!-- School Overview Header -->
     
<div class="d-flex align-items-center justify-content-between pt-5 mb-4">
    <div>
        <h2 class="fw-bold tracking-tight text-dark mb-1">{{ school.name }}</h2>
        <h2 class="fw-bold tracking-tight text-dark mb-1">School Overview</h2>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-2.5 py-1.5 rounded-pill fs-7">
                <i class="bi bi-calendar3 me-1"></i> {{ active_session }}
            </span>
            <span class="badge bg-secondary-subtle text-secondary fw-semibold px-2.5 py-1.5 rounded-pill fs-7">
                <i class="bi bi-clock me-1"></i> {{ active_term }}
            </span>
        </div>
    </div>
</div>

<!-- Stat Cards Grid -->
<div class="row g-4 mb-4">
    <!-- Students -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 transition-all hover-translate-y">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium fs-6 d-block mb-1">Total Students</span>
                    <h2 class="fw-extrabold text-dark mb-0">{{ student_count|default:"0" }}</h2>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-4 fs-3 d-inline-flex">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Teachers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 transition-all hover-translate-y">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium fs-6 d-block mb-1">Teachers</span>
                    <h2 class="fw-extrabold text-dark mb-0">{{ teacher_count|default:"0" }}</h2>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-4 fs-3 d-inline-flex">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Class Arms -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 transition-all hover-translate-y">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium fs-6 d-block mb-1">Class Arms</span>
                    <h2 class="fw-extrabold text-dark mb-0">{{ class_arm_count|default:"0" }}</h2>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-4 fs-3 d-inline-flex">
                    <i class="bi bi-building-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <!-- Subjects -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm p-4 rounded-4 h-100 transition-all hover-translate-y">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-medium fs-6 d-block mb-1">Subjects</span>
                    <h2 class="fw-extrabold text-dark mb-0">{{ subject_count|default:"0" }}</h2>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-4 fs-3 d-inline-flex">
                    <i class="bi bi-journal-text"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bottom Layout Section -->
<div class="row g-4">
    <!-- Quick Actions Panel -->
    <div class="col-xl-8">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold text-dark mb-0">Quick Actions</h5>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <a href="#" class="btn w-100 p-4 border border-dashed rounded-4 text-center text-decoration-none group transition-all hover-bg-light">
                            <div class="bg-primary-subtle text-primary mx-auto mb-3 p-3 rounded-circle d-inline-flex fs-4 transition-all group-hover-scale">
                                <i class="bi bi-person-plus-fill"></i>
                            </div>
                            <span class="d-block fw-bold text-dark">Register Student</span>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="#" class="btn w-100 p-4 border border-dashed rounded-4 text-center text-decoration-none group transition-all hover-bg-light">
                            <div class="bg-success-subtle text-success mx-auto mb-3 p-3 rounded-circle d-inline-flex fs-4 transition-all group-hover-scale">
                                <i class="bi bi-pencil-square"></i>
                            </div>
                            <span class="d-block fw-bold text-dark">Enter Assessment</span>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="#" class="btn w-100 p-4 border border-dashed rounded-4 text-center text-decoration-none group transition-all hover-bg-light">
                            <div class="bg-info-subtle text-info mx-auto mb-3 p-3 rounded-circle d-inline-flex fs-4 transition-all group-hover-scale">
                                <i class="bi bi-printer-fill"></i>
                            </div>
                            <span class="d-block fw-bold text-dark">Report Cards</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Academic Calendar Panel -->
    <div class="col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden">
            <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold text-dark mb-0">Academic Calendar</h5>
            </div>
            <div class="card-body p-4 pt-2">
                <div class="d-flex flex-column gap-3">
                    {% for term in terms %}
                        <div class="p-3 bg-light rounded-4 d-flex align-items-center justify-content-between border-start border-primary border-4">
                            <div>
                                <h6 class="fw-bold text-dark mb-1">{{ term.name }}</h6>
                                <span class="text-muted fs-7"><i class="bi bi-calendar-range me-1"></i> {{ term.start_date }} – {{ term.end_date }}</span>
                            </div>
                            <span class="badge bg-success-subtle text-success rounded-pill fw-semibold fs-8">Active</span>
                        </div>
                    {% empty %}
                        <div class="text-center py-4">
                            <div class="text-muted fs-1 mb-2"><i class="bi bi-calendar-x"></i></div>
                            <p class="text-muted mb-0 fw-medium">No active terms configured.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>

        </main>

    </div>

</div>



<!-- /////////////////////////////////// -->





{% endblock %}




